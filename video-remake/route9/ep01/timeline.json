   "scene": "mirror",
   "start": 65.618,
   "speech_end": 70.378,
   "end": 71.178,
   "overlay": null,
   "text": "In the mirror, they keep walking after your taillights. Long after they should have stopped.",
   "role": "narrator"
  },
