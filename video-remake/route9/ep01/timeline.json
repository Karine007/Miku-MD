   "scene": "traffic",
   "start": 24.508,
   "speech_end": 26.418,
   "end": 26.618,
   "overlay": null,
   "text": "Route 9 is never busy on a Tuesday.",
   "role": "narrator"
  },
  {
   "i": 6,
   "scene": "traffic",
   "start": 26.618,
   "speech_end": 28.838,
   "end": 30.038,
   "overlay": null,
   "text": "Tonight, every car is going the other way.",
   "role": "narrator"
  },
  {
   "i": 7,
   "scene": "car_radio",
   "start": 30.038,
   "speech_end": 36.858,
   "end": 37.358,
   "overlay": null,
   "text": "Reports of violent incidents across Harlan County. Drivers should avoid Route 9 north of mile marker one-twenty.",
