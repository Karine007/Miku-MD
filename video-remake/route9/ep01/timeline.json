   "i": 11,
   "scene": "brake",
   "start": 48.478,
   "speech_end": 50.638,
   "end": 51.638,
   "overlay": null,
   "text": "You brake hard. He doesn't move.",
   "role": "narrator"
  },
  {
   "i": 12,
   "scene": "man_turns",
   "start": 51.638,
   "speech_end": 56.568,
   "end": 57.068,
   "overlay": null,
   "text": "He turns around. Slowly. Like he's hearing a song only he can hear.",
   "role": "narrator"
  },
  {
