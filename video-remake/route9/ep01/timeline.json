   "scene": "mile_marker",
   "start": 37.358,
   "speech_end": 39.078,
   "end": 39.478,
   "overlay": null,
   "text": "You pass mile marker one-eighteen.",
   "role": "narrator"
  },
  {
   "i": 9,
   "scene": "trooper",
   "start": 39.478,
   "speech_end": 45.568,
   "end": 46.768,
   "overlay": null,
   "text": "A state trooper's car sits across the shoulder. Lights on. Door open. Nobody inside.",
   "role": "narrator"
  },
  {
